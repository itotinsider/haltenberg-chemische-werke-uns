      "FT-501": {"address": 500, "desc": "GOX product flow, kNm3/h"},
      "PT-502": {"address": 502, "desc": "GOX header pressure, bar(g)"},
      "FT-503": {"address": 504, "desc": "GAN product flow, kNm3/h"},
      "PT-504": {"address": 506, "desc": "GAN header pressure, bar(g)"},
      "LT-505": {"address": 508, "desc": "LOX tank level, %"},
      "LT-506": {"address": 510, "desc": "LIN tank level, %"},
      "FT-507": {"address": 512, "desc": "LOX backup vaporizer E-507 send-out, kNm3/h"},
