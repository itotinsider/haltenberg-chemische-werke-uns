      "PT-516": {"address": 526, "desc": "LOX backup pump P-505 discharge pressure, bar(g)"},
      "PT-517": {"address": 528, "desc": "LIN backup pump P-506 discharge pressure, bar(g)"},
      "AT-601": {"address": 600, "desc": "GOX purity, % O2"},
      "AT-602": {"address": 602, "desc": "O2 in GAN, ppm"},
      "AT-603": {"address": 604, "desc": "Total hydrocarbons in LOX, ppm CH4-eq"},
      "AT-604": {"address": 606, "desc": "Acetylene in LOX, ppm"},
      "HB-900": {"address": 900, "desc": "Plant I/O heartbeat counter"}
    }
  },
  "holding_registers": {
    "function_codes": "FC3/FC16",
    "direction": "DCS -> plant",
    "writer": "dcs/config.py out=",
    "reader": "plant/model.py ao",
    "requests": ["100+6", "200+2", "300+2", "400+10", "500+8", "900+2"],
    "points": {
      "FV-101": {"address": 100, "desc": "MAC inlet guide vanes"},
      "UV-103": {"address": 102, "desc": "MAC antisurge recycle valve"},
      "FV-111": {"address": 104, "desc": "Booster inlet guide vanes"},
      "TV-204": {"address": 200, "desc": "Regeneration heater power"},
      "FV-303": {"address": 300, "desc": "Expander inlet nozzles"},
      "PV-402": {"address": 400, "desc": "LP column waste N2 vent valve"},
      "LV-403": {"address": 402, "desc": "HP sump rich-liquid valve"},
      "LV-404": {"address": 404, "desc": "LOX draw-to-storage valve"},
      "FV-405": {"address": 406, "desc": "LIN reflux valve"},
      "FV-409": {"address": 408, "desc": "LIN draw-to-storage valve"},
      "FV-501": {"address": 500, "desc": "LOX pump P-501 discharge flow valve"},
      "FV-503": {"address": 502, "desc": "GAN compressor K-503 inlet guide vanes"},
      "FV-507": {"address": 504, "desc": "LOX backup vaporizer E-507 flow valve (P-505)"},
      "FV-508": {"address": 506, "desc": "LIN backup vaporizer E-508 flow valve (P-506)"},
      "WD-900": {"address": 900, "desc": "DCS watchdog counter"}
    }
  },
  "discrete_inputs": {
    "function_codes": "FC2",
    "direction": "plant -> DCS",
    "writer": "plant/model.py discretes()",
    "reader": "dcs/config.py EQUIPMENT fb=",
    "points": {
      "YS-101": {"address": 10, "desc": "MAC motor running"},
      "YS-102": {"address": 11, "desc": "Booster air compressor running"},
      "ZS-201A": {"address": 20, "desc": "PPU bed A online"},
      "ZS-201B": {"address": 21, "desc": "PPU bed B online"},
      "YS-301": {"address": 30, "desc": "Expander running"},
      "YS-501": {"address": 50, "desc": "LOX pump P-501 running"},
      "YS-503": {"address": 51, "desc": "GAN compressor K-503 running"},
      "YS-505": {"address": 52, "desc": "LOX backup pump P-505 running"},
      "YS-506": {"address": 53, "desc": "LIN backup pump P-506 running"}
    }
  },
  "coils": {
    "function_codes": "FC1/FC5/FC15",
    "direction": "DCS -> plant",
    "writer": "dcs/config.py EQUIPMENT cmd=",
    "reader": "plant/model.py do",
    "points": {
      "HS-101": {"address": 10, "desc": "MAC run command"},
      "HS-102": {"address": 11, "desc": "Booster air compressor run command"},
      "HS-201": {"address": 20, "desc": "PPU bed B select (0 = bed A online, 1 = bed B online)"},
      "HS-301": {"address": 30, "desc": "Expander run command"},
      "HS-501": {"address": 50, "desc": "LOX pump P-501 run command"},
      "HS-503": {"address": 51, "desc": "GAN compressor K-503 run command"},
      "HS-505": {"address": 52, "desc": "LOX backup pump P-505 run command"},
      "HS-506": {"address": 53, "desc": "LIN backup pump P-506 run command"}
    }
  }
}
