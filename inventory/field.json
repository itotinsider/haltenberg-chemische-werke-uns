{
  "_source": "common/iomap.py",
  "encoding": "float32 = 2 registers, big-endian word order; addresses 0-based, fixed per process area (registers n*100.., bits n*10.. for tag numbers n..)",
  "input_registers": {
    "function_codes": "FC4",
    "direction": "plant -> DCS",
    "writer": "plant/model.py measurements()",
    "reader": "dcs/config.py io=",
    "requests": ["100+26", "200+8", "300+36", "400+18", "500+30", "600+8", "900+2"],
    "points": {
      "FT-101": {"address": 100, "desc": "MAC forward air flow, kNm3/h"},
      "PT-102": {"address": 102, "desc": "MAC discharge pressure, bar(a)"},
      "FT-103": {"address": 104, "desc": "MAC suction (compressor) flow, kNm3/h"},
      "JT-104": {"address": 106, "desc": "MAC motor power, MW"},
      "VT-105": {"address": 108, "desc": "MAC bearing vibration DE, mm/s"},
      "TT-106": {"address": 110, "desc": "MAC bearing temperature, degC"},
      "PT-107": {"address": 112, "desc": "MAC lube-oil pressure, bar(g)"},
      "TT-108": {"address": 114, "desc": "Air temperature after DCAC, degC"},
      "TT-109": {"address": 116, "desc": "Ambient air temperature, degC"},
      "FT-111": {"address": 118, "desc": "Booster air flow (K-102), kNm3/h"},
      "PT-112": {"address": 120, "desc": "Booster discharge pressure, bar(a)"},
      "JT-113": {"address": 122, "desc": "Booster motor power, MW"},
      "VT-114": {"address": 124, "desc": "Booster bearing vibration, mm/s"},
      "AT-202": {"address": 200, "desc": "CO2 at PPU outlet, ppm"},
      "PDT-203": {"address": 202, "desc": "PPU bed differential pressure, mbar"},
      "TT-204": {"address": 204, "desc": "Regeneration gas temperature, degC"},
      "ZT-205": {"address": 206, "desc": "Switching valve stroke time (last), s"},
      "TT-301": {"address": 300, "desc": "MHE cold-end air temperature, degC"},
      "TDT-302": {"address": 302, "desc": "MHE warm-end delta T, K"},
      "FT-303": {"address": 304, "desc": "Expander flow, kNm3/h"},
      "ST-304": {"address": 306, "desc": "Expander speed, rpm"},
      "VT-305": {"address": 308, "desc": "Expander vibration, um"},
      "TT-306": {"address": 310, "desc": "Expander bearing temperature, degC"},
      "TT-307": {"address": 312, "desc": "Main air into E-301 (warm end), degC"},
      "TT-308": {"address": 314, "desc": "Booster air into E-301 (warm end), degC"},
