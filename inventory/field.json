      "TT-311": {"address": 320, "desc": "Booster air leaving E-301 (cold end, liquid), degC"},
      "TT-312": {"address": 322, "desc": "Pumped LOX into E-301 (cold end), degC"},
      "TT-313": {"address": 324, "desc": "GAN into E-301 (cold end), degC"},
      "TT-314": {"address": 326, "desc": "Waste N2 into E-301 (cold end), degC"},
      "TT-315": {"address": 328, "desc": "Expander inlet temperature, degC"},
      "PT-316": {"address": 330, "desc": "Expander inlet pressure, bar(a)"},
      "TT-317": {"address": 332, "desc": "Expander outlet temperature, degC"},
      "PT-318": {"address": 334, "desc": "Expander outlet pressure, bar(a)"},
      "PT-401": {"address": 400, "desc": "HP column top pressure, bar(a)"},
      "PT-402": {"address": 402, "desc": "LP column top pressure, bar(a)"},
      "LT-403": {"address": 404, "desc": "HP column sump level, %"},
      "LT-404": {"address": 406, "desc": "Reboiler / LP sump level, %"},
      "FT-405": {"address": 408, "desc": "LIN reflux to LP column, kNm3/h"},
