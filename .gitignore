__pycache__/
*.pyc
.DS_Store

# runtime state (bind mounts)
data/*
!data/.gitkeep
# the other sites' DCS data folders come from git, so Docker doesn't create them as root
!data/port-arden/
!data/vadhana/
data/port-arden/*
data/vadhana/*
!data/port-arden/.gitkeep
!data/vadhana/.gitkeep
exports/*
!exports/.gitkeep

# Node-RED: only the hand-written flow is tracked
nodered_data/*
!nodered_data/flows.json

# per-worktree stack settings (stack name, host ports)
.env
